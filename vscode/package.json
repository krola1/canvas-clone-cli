{
  "name": "canvas-clone-vscode",
  "displayName": "Canvas Clone",
  "description": "Velg kurs og oppgave i Canvas og klon elevenes GitHub-repo - fra VS Code. Under utvikling.",
  "publisher": "krola1",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/krola1/canvas-clone-cli.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.canvas-clone-okt"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Canvas Clone åpner elevkode i et eget vindu uten tillit. Utvidelsen kjører ingen kode fra workspace og leser ingen innstillinger derfra."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "canvasClone.setup",
        "title": "Oppsett (Canvas-URL og token)",
        "category": "Canvas Clone"
      },
      {
        "command": "canvasClone.deleteToken",
        "title": "Slett token og Canvas-URL",
        "category": "Canvas Clone"
      },
      {
        "command": "canvasClone.ferdig",
        "title": "Ferdig med økten (lukk og slett)",
        "category": "Canvas Clone"
      },
      {
        "command": "canvasClone.oppdater",
        "title": "Oppdater fra Canvas",
        "category": "Canvas Clone",
        "icon": "$(refresh)"
      },
      {
        "command": "canvasClone.klon",
        "title": "Klon …",
        "category": "Canvas Clone",
        "icon": "$(repo-clone)"
      },
      {
        "command": "canvasClone.klonPaTvers",
        "title": "Klon på tvers av kurs …",
        "category": "Canvas Clone",
        "icon": "$(globe)"
      },
      {
        "command": "canvasClone.settKarakter",
        "title": "Sett karakter …",
        "category": "Canvas Clone",
        "icon": "$(edit)"
      },
      {
        "command": "canvasClone.visRester",
        "title": "Vis hva som ble liggende",
        "category": "Canvas Clone"
      },
      {
        "command": "canvasClone.slettAlle",
        "title": "Slett alle økter nå",
        "category": "Canvas Clone"
      },
      {
        "command": "canvasClone.about",
        "title": "Om",
        "category": "Canvas Clone"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "canvasClone.ferdig",
          "when": "canvasClone.oktvindu"
        },
        {
          "command": "canvasClone.klon",
          "when": "false"
        },
        {
          "command": "canvasClone.settKarakter",
          "when": "false"
        },
        {
          "command": "canvasClone.oppdater",
          "when": "!canvasClone.oktvindu"
        },
        {
          "command": "canvasClone.klonPaTvers",
          "when": "!canvasClone.oktvindu"
        },
        {
          "command": "canvasClone.visRester",
          "when": "!canvasClone.oktvindu"
        },
        {
          "command": "canvasClone.slettAlle",
          "when": "!canvasClone.oktvindu"
        }
      ],
      "view/title": [
        {
          "command": "canvasClone.klonPaTvers",
          "when": "view == canvasClone.tre",
          "group": "navigation@1"
        },
        {
          "command": "canvasClone.oppdater",
          "when": "view == canvasClone.tre",
          "group": "navigation@2"
        },
        {
          "command": "canvasClone.visRester",
          "when": "view == canvasClone.tre",
          "group": "t12@1"
        },
        {
          "command": "canvasClone.slettAlle",
          "when": "view == canvasClone.tre",
          "group": "t12@2"
        }
      ],
      "view/item/context": [
        {
          "command": "canvasClone.klon",
          "when": "view == canvasClone.tre && viewItem =~ /^(kurs|fagretning|modul|oppgave|innlevering)$/",
          "group": "inline"
        },
        {
          "command": "canvasClone.klon",
          "when": "view == canvasClone.tre && viewItem =~ /^(kurs|fagretning|modul|oppgave|innlevering)$/",
          "group": "klon@1"
        },
        {
          "command": "canvasClone.settKarakter",
          "when": "view == canvasClone.tre && viewItem == innlevering",
          "group": "inline"
        },
        {
          "command": "canvasClone.settKarakter",
          "when": "view == canvasClone.tre && viewItem == innlevering",
          "group": "karakter@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "canvasClone",
          "title": "Canvas Clone",
          "icon": "media/canvas-clone.svg"
        }
      ]
    },
    "views": {
      "canvasClone": [
        {
          "id": "canvasClone.tre",
          "name": "Canvas Clone",
          "when": "!canvasClone.oktvindu"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "package": "npm run build && vsce package",
    "check-package": "node scripts/check-package.mjs",
    "release-check": "node scripts/release-check.mjs",
    "test": "npm run build && vscode-test",
    "test:uten-tillit": "npm run build && node scripts/kjor-uten-tillit.mjs"
  },
  "devDependencies": {
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3"
  },
  "overrides": {
    "@vscode/test-cli": {
      "mocha": "$mocha"
    }
  }
}
